# Copy this file to .env and replace the placeholders with authorized development credentials.
# Never commit the resulting .env file or real database credentials.

DB_URL='jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require'
DB_USERNAME='YOUR_NEON_USERNAME'
DB_PASSWORD='YOUR_NEON_PASSWORD'
# Optional direct (non-pooler) URL for Flyway migrations. If omitted, Flyway uses DB_URL.
# FLYWAY_DB_URL='jdbc:postgresql://YOUR_NEON_DIRECT_HOST/neondb?sslmode=require&channel_binding=require'
SERVER_PORT='8080'

# Exact browser origins allowed to call REST APIs (no wildcard).
# The dev profile uses these defaults; production must set its deployed frontend origin explicitly.
REST_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exact browser origins allowed to open chat sockets (no wildcard).
CHAT_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Local SMTP capture server. Replace with your provider to deliver to IUT inboxes.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
VERIFICATION_FROM=no-reply@uniconnect.local
