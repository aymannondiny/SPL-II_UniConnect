        <mxCell id="eActorModeration" edge="1" parent="1" source="user" target="moderation" value="actor 1     actions 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=16;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="950" /><mxPoint x="1450" y="1450" /></Array></mxGeometry></mxCell>
        <mxCell id="eModerationActionType" edge="1" parent="1" source="moderation" target="actionType" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=16;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2110" y="1510" /><mxPoint x="2110" y="700" /></Array></mxGeometry></mxCell>
        <mxCell id="eTargetUser" edge="1" parent="1" source="moderation" target="user" value="target 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;fontSize=15;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="1440" /><mxPoint x="760" y="270" /></Array></mxGeometry></mxCell>
        <mxCell id="eTargetClub" edge="1" parent="1" source="moderation" target="club" value="target 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;fontSize=15;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="1510" /><mxPoint x="610" y="240" /></Array></mxGeometry></mxCell>
        <mxCell id="eTargetAnnouncement" edge="1" parent="1" source="moderation" target="announcement" value="target 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;fontSize=15;"><mxGeometry relative="1" as="geometry" /></mxCell>
