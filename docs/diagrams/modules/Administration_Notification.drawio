        </mxCell>
        <mxCell id="accountStatus" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;AccountStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;PENDING_VERIFICATION&lt;br&gt;ACTIVE&lt;br&gt;SUSPENDED&lt;/div&gt;" vertex="1">
          <mxGeometry x="2260" y="130" width="390" height="230" as="geometry" />
        </mxCell>

        <mxCell id="adminService" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«domain service»&lt;br&gt;AdministrationService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.38;&quot;&gt;+ searchUsers(criteria)&lt;br&gt;+ suspendAccount(targetUser, reason)&lt;br&gt;+ reactivateAccount(targetUser)&lt;br&gt;+ createClub(details, firstAdministrator)&lt;br&gt;+ replaceClubAdministrator(club, replacement)&lt;br&gt;+ suspendClubPublishing(club, reason)&lt;br&gt;+ restoreClubPublishing(club)&lt;br&gt;+ removeClub(club, reason)&lt;br&gt;+ removeAnnouncement(announcement, reason)&lt;br&gt;+ removeProject(project, reason)&lt;br&gt;+ removeJobPost(jobPost, reason)&lt;/div&gt;" vertex="1">
          <mxGeometry x="900" y="570" width="600" height="550" as="geometry" />
        </mxCell>
