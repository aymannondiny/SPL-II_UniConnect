          <mxGeometry x="80" y="430" width="430" height="360" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- userId : Long&lt;br&gt;- fullName : String&lt;br&gt;- email : String {unique}&lt;br&gt;- platformRole : PlatformRole&lt;br&gt;- accountStatus : AccountStatus&lt;/div&gt;" vertex="1">
          <mxGeometry x="920" y="110" width="470" height="320" as="geometry" />
        </mxCell>
        <mxCell id="session" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;AuthenticatedSession&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- sessionId : UUID&lt;br&gt;- expiresAt : LocalDateTime&lt;br&gt;- revokedAt : LocalDateTime [0..1]&lt;br&gt;- revocationReason : String [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;+ revoke(reason)&lt;/div&gt;" vertex="1">
