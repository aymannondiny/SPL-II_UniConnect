        </mxCell>
        <mxCell id="project" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«module reference»&lt;br&gt;Project&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- projectId : Long&lt;br&gt;- status : ProjectStatus&lt;/div&gt;" vertex="1">
          <mxGeometry x="70" y="1350" width="400" height="210" as="geometry" />
        </mxCell>
        <mxCell id="jobPost" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«module reference»&lt;br&gt;JobPost&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- jobPostId : Long&lt;br&gt;- status : JobPostStatus&lt;/div&gt;" vertex="1">
          <mxGeometry x="70" y="1660" width="400" height="210" as="geometry" />
        </mxCell>

        <mxCell id="moderation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;ModerationAction&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.38;&quot;&gt;- actionId : Long&lt;br&gt;- actionType : ActionType&lt;br&gt;- reason : String&lt;br&gt;- previousState : String [0..1]&lt;br&gt;- newState : String [0..1]&lt;br&gt;- createdAt : LocalDateTime&lt;br&gt;- reversedAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.38;&quot;&gt;+ isReversible() : boolean&lt;br&gt;+ createReversal() : ModerationAction&lt;/div&gt;" vertex="1">
          <mxGeometry x="820" y="1300" width="540" height="480" as="geometry" />
        </mxCell>

        <mxCell id="notification" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;Notification&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;- notificationId : Long&lt;br&gt;- type : NotificationType&lt;br&gt;- title : String&lt;br&gt;- message : String&lt;br&gt;- referenceType : NotificationReferenceType [0..1]&lt;br&gt;- referenceId : Long [0..1]&lt;br&gt;- eventKey : String {unique per recipient}&lt;br&gt;- createdAt : LocalDateTime&lt;br&gt;- readAt : LocalDateTime [0..1]&lt;br&gt;- dismissedAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;+ markAsRead()&lt;br&gt;+ markAsUnread()&lt;br&gt;+ dismiss()&lt;br&gt;+ openReference()&lt;/div&gt;" vertex="1">
          <mxGeometry x="1550" y="1130" width="580" height="610" as="geometry" />
        </mxCell>
        <mxCell id="notificationType" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=16;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;NotificationType&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.3;&quot;&gt;ACCOUNT_SUSPENDED&lt;br&gt;ACCOUNT_REACTIVATED&lt;br&gt;CLUB_ROLE_GRANTED&lt;br&gt;CLUB_ROLE_REVOKED&lt;br&gt;PUBLISHING_SUSPENDED&lt;br&gt;PUBLISHING_RESTORED&lt;br&gt;CONNECTION_REQUESTED&lt;br&gt;CONNECTION_ACCEPTED&lt;br&gt;PROJECT_APPLICATION_DECIDED&lt;br&gt;MENTORSHIP_CHANGED&lt;br&gt;NEW_ANNOUNCEMENT&lt;br&gt;NEW_JOB_POST&lt;br&gt;SYSTEM_ANNOUNCEMENT&lt;/div&gt;" vertex="1">
          <mxGeometry x="2260" y="1000" width="430" height="510" as="geometry" />
        </mxCell>
        <mxCell id="referenceType" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=16;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;NotificationReferenceType&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.3;&quot;&gt;USER&lt;br&gt;CLUB&lt;br&gt;CLUB_ROLE_ASSIGNMENT&lt;br&gt;ANNOUNCEMENT&lt;br&gt;CONNECTION&lt;br&gt;PROJECT_APPLICATION&lt;br&gt;MENTORSHIP_SLOT&lt;br&gt;JOB_POST&lt;/div&gt;" vertex="1">
          <mxGeometry x="2260" y="1580" width="430" height="370" as="geometry" />
        </mxCell>

        <mxCell id="audit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;AuditLog&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;- auditLogId : Long&lt;br&gt;- eventType : AuditEventType&lt;br&gt;- subjectType : String&lt;br&gt;- subjectId : Long&lt;br&gt;- reason : String [0..1]&lt;br&gt;- previousStateJson : String [0..1]&lt;br&gt;- newStateJson : String [0..1]&lt;br&gt;- requestId : UUID [0..1]&lt;br&gt;- occurredAt : LocalDateTime&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;+ getSummary() : String&lt;/div&gt;" vertex="1">
          <mxGeometry x="1510" y="1900" width="590" height="500" as="geometry" />
        </mxCell>
        <mxCell id="auditEventType" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=15;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;AuditEventType&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.25;&quot;&gt;ACCOUNT_SUSPENDED&lt;br&gt;ACCOUNT_REACTIVATED&lt;br&gt;CLUB_CREATED&lt;br&gt;CLUB_ADMINISTRATOR_APPOINTED&lt;br&gt;CLUB_ADMINISTRATOR_REPLACED&lt;br&gt;CLUB_PUBLISHING_SUSPENDED&lt;br&gt;CLUB_PUBLISHING_RESTORED&lt;br&gt;CLUB_REMOVED&lt;br&gt;ANNOUNCEMENT_REMOVED&lt;br&gt;PROJECT_REMOVED&lt;br&gt;JOB_POST_REMOVED&lt;/div&gt;" vertex="1">
          <mxGeometry x="2230" y="2020" width="460" height="440" as="geometry" />
        </mxCell>

        <mxCell id="constraints" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=16;" value="&lt;b&gt;Administration and notification constraints&lt;/b&gt;&lt;br&gt;D1. There is no AdminProfile or AdminRole. Administration authority requires User.platformRole = SYSTEM_ADMIN and User.accountStatus = ACTIVE.&lt;br&gt;D2. Suspending an account atomically sets AccountStatus = SUSPENDED and revokes every current AuthenticatedSession. Reactivation never restores revoked sessions.&lt;br&gt;D3. Creating a Club and appointing its first administrator is atomic. Replacing an administrator atomically revokes the old assignment and creates the new one.&lt;br&gt;D4. If a current club administrator is suspended, the Club becomes PUBLISHING_SUSPENDED until an ACTIVE STUDENT replacement is appointed. Publishing cannot be restored earlier.&lt;br&gt;D5. PUBLISHING_SUSPENDED blocks new publication but leaves the Club profile and already-published announcements visible. Removing a Club sets REMOVED and preserves history.&lt;br&gt;D6. Every ModerationAction has exactly one typed target: User, Club, Announcement, Project, or JobPost. Only an ACTIVE SYSTEM_ADMIN may perform it.&lt;br&gt;D7. Every state-changing administration action appends an immutable AuditLog containing actor, target, event, time, reason where required, and previous/new state. Reversal creates a new action and log entry.&lt;br&gt;D8. Each Notification has exactly one recipient. The pair (recipient, eventKey) is unique so the same event is not notified twice.&lt;br&gt;D9. Opening a notification rechecks current authorization. A notification never restores access or grants authority; an unavailable target produces a clear message.&lt;br&gt;D10. User, AuthenticatedSession, Club, ClubRoleAssignment, Announcement, Project, and JobPost are references to their owning modules and are not redefined here." vertex="1">
          <mxGeometry x="100" y="2500" width="2580" height="260" as="geometry" />
        </mxCell>

        <mxCell id="eUserStatus" edge="1" parent="1" source="user" target="accountStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=16;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eUserSession" edge="1" parent="1" source="user" target="session" value="user 1     sessions 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=16;"><mxGeometry relative="1" as="geometry" /></mxCell>
