        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" value="UniConnect – Corrected Administration and Notification Class Diagram" vertex="1">
          <mxGeometry x="400" y="20" width="2000" height="50" as="geometry" />
        </mxCell>

        <mxCell id="club" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;Club&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- clubId : Long&lt;br&gt;- clubName : String&lt;br&gt;- status : ClubStatus&lt;/div&gt;" vertex="1">
