        <mxCell id="eJobSaved" edge="1" parent="1" source="job" target="saved" value="post 1     saves 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eStudentSaved" edge="1" parent="1" source="student" target="saved" value="student 1     saved jobs 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1535" y="350" /><mxPoint x="1535" y="810" /></Array></mxGeometry></mxCell>
