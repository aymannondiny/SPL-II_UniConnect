        <mxCell id="eJobNotification" edge="1" parent="1" source="job" target="notification" value="triggers 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eModerationJob" edge="1" parent="1" source="moderation" target="job" value="target 1     actions 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eJobStatus" edge="1" parent="1" source="job" target="status" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eEmploymentType" edge="1" parent="1" source="job" target="employmentType" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eWorkMode" edge="1" parent="1" source="job" target="workMode" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
