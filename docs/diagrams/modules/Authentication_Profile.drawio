  <diagram id="auth-profile-corrected" name="Corrected Authentication and Profiles">
    <mxGraphModel dx="2400" dy="2600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2730" math="0" shadow="0">
