        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" value="UniConnect – Corrected Authentication, Authorization and Profile Domain Model" vertex="1">
          <mxGeometry x="300" y="20" width="1800" height="50" as="geometry" />
        </mxCell>

        <mxCell id="platformRole" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;PlatformRole&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;STUDENT&lt;br&gt;ALUMNI&lt;br&gt;SYSTEM_ADMIN&lt;/div&gt;" vertex="1">
          <mxGeometry x="100" y="150" width="320" height="210" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;«shared entity»&lt;br&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- userId : Long&lt;br&gt;- fullName : String [0..1]&lt;br&gt;- email : String [0..1] {unique where present}&lt;br&gt;- passwordHash : String [0..1]&lt;br&gt;- platformRole : PlatformRole&lt;br&gt;- accountStatus : AccountStatus&lt;br&gt;- anonymizedAt : LocalDateTime [0..1]&lt;br&gt;- createdAt : LocalDateTime&lt;br&gt;- updatedAt : LocalDateTime&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ canAuthenticate() : boolean&lt;br&gt;+ canPerformProtectedAction() : boolean&lt;br&gt;+ isAnonymized() : boolean&lt;/div&gt;" vertex="1">
          <mxGeometry x="760" y="110" width="520" height="570" as="geometry" />
