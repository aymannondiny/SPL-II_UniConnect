        </mxCell>
        <mxCell id="resetToken" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;PasswordResetToken&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- tokenId : Long&lt;br&gt;- tokenHash : String {unique}&lt;br&gt;- createdAt : LocalDateTime&lt;br&gt;- expiresAt : LocalDateTime&lt;br&gt;- usedAt : LocalDateTime [0..1]&lt;br&gt;- revokedAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;+ isUsable() : boolean&lt;br&gt;+ markUsed()&lt;br&gt;+ revoke()&lt;/div&gt;" vertex="1">
          <mxGeometry x="1980" y="610" width="420" height="410" as="geometry" />
        </mxCell>

        <mxCell id="personalProfile" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«abstract»&lt;br&gt;PersonalProfile&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- profileId : Long&lt;br&gt;- bio : String [0..1]&lt;br&gt;- profilePhotoUrl : String [0..1]&lt;br&gt;- createdAt : LocalDateTime&lt;br&gt;- updatedAt : LocalDateTime&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;+ updatePermittedFields()&lt;/div&gt;" vertex="1">
          <mxGeometry x="790" y="1350" width="460" height="350" as="geometry" />
        </mxCell>
        <mxCell id="studentProfile" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;StudentProfile&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- studentNumber : String {unique}&lt;br&gt;- yearOfStudy : Integer&lt;br&gt;- expectedGraduationYear : Integer [0..1]&lt;br&gt;- projectAvailability : boolean&lt;br&gt;- mentorshipAvailability : boolean&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;+ updateAcademicInfo()&lt;br&gt;+ setAvailability()&lt;/div&gt;" vertex="1">
          <mxGeometry x="390" y="1800" width="450" height="370" as="geometry" />
        </mxCell>
        <mxCell id="alumniProfile" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;AlumniProfile&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- graduationYear : Integer&lt;br&gt;- currentCompany : String [0..1]&lt;br&gt;- currentPosition : String [0..1]&lt;br&gt;- industry : String [0..1]&lt;br&gt;- careerBackground : String [0..1]&lt;br&gt;- linkedinUrl : String [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;+ updateCareerInfo()&lt;br&gt;+ updateProfessionalLinks()&lt;/div&gt;" vertex="1">
          <mxGeometry x="1190" y="1800" width="490" height="430" as="geometry" />
        </mxCell>

        <mxCell id="skill" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;Skill&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- skillId : Long&lt;br&gt;- skillName : String {unique}&lt;br&gt;- category : String [0..1]&lt;/div&gt;" vertex="1">
          <mxGeometry x="30" y="1460" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="interest" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;Interest&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- interestId : Long&lt;br&gt;- interestName : String {unique}&lt;/div&gt;" vertex="1">
          <mxGeometry x="30" y="1860" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="department" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;Department&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- departmentId : Long&lt;br&gt;- departmentName : String&lt;br&gt;- departmentCode : String {unique}&lt;/div&gt;" vertex="1">
          <mxGeometry x="2020" y="1210" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="programme" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;Programme&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- programmeId : Long&lt;br&gt;- programmeName : String&lt;br&gt;- programmeCode : String {unique}&lt;/div&gt;" vertex="1">
          <mxGeometry x="2020" y="1570" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="programmeDegree" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;ProgrammeDegree&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- programmeDegreeId : Long&lt;br&gt;- degreeLevel : DegreeLevel&lt;br&gt;- durationYears : Integer&lt;br&gt;- minimumYear : Integer&lt;br&gt;- maximumYear : Integer&lt;br&gt;- active : boolean&lt;/div&gt;" vertex="1">
          <mxGeometry x="1950" y="1930" width="410" height="330" as="geometry" />
        </mxCell>

        <mxCell id="constraints" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=17;" value="&lt;b&gt;Authentication and profile constraints&lt;/b&gt;&lt;br&gt;A1. AccountStatus is the single source of verification/access state; there is no emailVerified boolean.&lt;br&gt;A2. Registration creates PENDING_VERIFICATION. A usable verification token changes it to ACTIVE and can be consumed only once.&lt;br&gt;A3. Only ACTIVE users with anonymizedAt = null may create sessions or perform protected actions.&lt;br&gt;A4. A session is valid only while it is unrevoked, unexpired, and its User remains ACTIVE. Every protected request rechecks both session and account.&lt;br&gt;A5. Suspension atomically revokes every current session. Reactivation does not restore revoked sessions and is prohibited when anonymizedAt is set.&lt;br&gt;A6. ActiveContext is selected per session and never creates authority; authorization still revalidates PlatformRole and any club assignment.&lt;br&gt;A7. A User has at most one PersonalProfile. Its concrete type must match PlatformRole: STUDENT → StudentProfile, ALUMNI → AlumniProfile. SYSTEM_ADMIN has no separate AdminProfile.&lt;br&gt;A8. Raw verification, reset, and refresh tokens are never stored; only secure hashes are persisted.&lt;br&gt;A9. Profile visibility and field editing remain subject to privacy and ownership rules.&lt;br&gt;A10. Anonymization atomically revokes sessions and outstanding tokens, erases credentials/direct identifiers and the PersonalProfile, sets anonymizedAt, and is irreversible; retained history displays Former User." vertex="1">
          <mxGeometry x="80" y="2320" width="2240" height="330" as="geometry" />
        </mxCell>

        <mxCell id="eUserRole" edge="1" parent="1" source="user" target="platformRole" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eUserStatus" edge="1" parent="1" source="user" target="accountStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eUserVerification" edge="1" parent="1" source="user" target="verificationToken" value="owner 1     tokens 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eUserSession" edge="1" parent="1" source="user" target="session" value="user 1     sessions 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eUserReset" edge="1" parent="1" source="user" target="resetToken" value="owner 1     tokens 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eSessionContext" edge="1" parent="1" source="session" target="activeContext" value="session 1     selected context 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eUserProfile" edge="1" parent="1" source="user" target="personalProfile" value="user 1     personal profile 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;endArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eStudentGeneralization" edge="1" parent="1" source="studentProfile" target="personalProfile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eAlumniGeneralization" edge="1" parent="1" source="alumniProfile" target="personalProfile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eStudentSkill" edge="1" parent="1" source="studentProfile" target="skill" value="0..*     0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eAlumniSkill" edge="1" parent="1" source="alumniProfile" target="skill" value="0..*     0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="1760" /><mxPoint x="180" y="1760" /></Array></mxGeometry></mxCell>
        <mxCell id="eStudentInterest" edge="1" parent="1" source="studentProfile" target="interest" value="0..*     0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eDepartmentProgramme" edge="1" parent="1" source="department" target="programme" value="department 1     programmes 1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eProgrammeDegree" edge="1" parent="1" source="programme" target="programmeDegree" value="programme 1     degrees 1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eStudentDegree" edge="1" parent="1" source="studentProfile" target="programmeDegree" value="students 0..*     degree 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eAlumniDegree" edge="1" parent="1" source="alumniProfile" target="programmeDegree" value="alumni 0..*     degree 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
