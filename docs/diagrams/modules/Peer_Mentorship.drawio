        <mxCell id="eSkillExpertise" edge="1" parent="1" source="skill" target="expertise" value="skill 1     mentor uses 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2520" y="380" /><mxPoint x="1520" y="380" /></Array></mxGeometry></mxCell>
        <mxCell id="eMentorSlot" edge="1" parent="1" source="mentor" target="slot" value="creator 1     slots 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eSlotOccurrence" edge="1" parent="1" source="slot" target="occurrence" value="slot 1     occurrences 1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eSlotEnrollment" edge="1" parent="1" source="slot" target="enrollment" value="slot 1     enrollments 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eMentee" edge="1" parent="1" source="student" target="enrollment" value="mentee 1     enrollments 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="350" /><mxPoint x="1580" y="1200" /></Array></mxGeometry></mxCell>
        <mxCell id="eService" edge="1" parent="1" source="service" target="mentor" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eSlotNotification" edge="1" parent="1" source="slot" target="notification" value="triggers 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eEnrollmentNotification" edge="1" parent="1" source="enrollment" target="notification" value="triggers 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eMentorStatus" edge="1" parent="1" source="mentor" target="mentorStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eScheduleType" edge="1" parent="1" source="slot" target="scheduleType" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eMode" edge="1" parent="1" source="slot" target="mode" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eSlotStatus" edge="1" parent="1" source="slot" target="slotStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
