        <mxCell id="eAssignmentNotification" edge="1" parent="1" source="assignment" target="notification" value="triggers 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="1260" /><mxPoint x="1460" y="1260" /></Array></mxGeometry></mxCell>
      <mxCell id="announcementPriority" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;fontSize=18;" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;b&gt;«enumeration»&lt;br&gt;AnnouncementPriority&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;NORMAL&lt;br&gt;IMPORTANT&lt;br&gt;URGENT&lt;/div&gt;" vertex="1"><mxGeometry x="910" y="1050" width="330" height="220" as="geometry" /></mxCell><mxCell id="event" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;Event&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;- eventId : Long&lt;br&gt;- title : String&lt;br&gt;- description : String&lt;br&gt;- location : String [0..1]&lt;br&gt;- startsAt : LocalDateTime&lt;br&gt;- endsAt : LocalDateTime&lt;br&gt;- status : EventStatus&lt;br&gt;- publishedAt : LocalDateTime&lt;br&gt;- updatedAt : LocalDateTime [0..1]&lt;br&gt;- removedAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;+ timingLabel(at) : EventTimingLabel&lt;br&gt;+ isInCurrentList(at) : boolean&lt;br&gt;+ edit()&lt;br&gt;+ remove()&lt;/div&gt;" vertex="1"><mxGeometry x="1800" y="360" width="520" height="620" as="geometry" /></mxCell><mxCell id="eventStatus" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;EventStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;PUBLISHED&lt;br&gt;REMOVED&lt;/div&gt;" vertex="1"><mxGeometry x="1740" y="1050" width="300" height="190" as="geometry" /></mxCell><mxCell id="eventTimingLabel" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«derived enumeration»&lt;br&gt;EventTimingLabel&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;UPCOMING&lt;br&gt;ACTIVE&lt;br&gt;PAST&lt;/div&gt;" vertex="1"><mxGeometry x="2090" y="1050" width="340" height="220" as="geometry" /></mxCell><mxCell id="eClubEvent" edge="1" parent="1" source="club" target="event" value="club 1     events 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=16;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eAssignmentEvent" edge="1" parent="1" source="assignment" target="event" value="authored under 1     events 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=16;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eEventStatus" edge="1" parent="1" source="event" target="eventStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=16;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eEventTiming" edge="1" parent="1" source="event" target="eventTimingLabel" value="derives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=16;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eModeratesEvent" edge="1" parent="1" source="moderation" target="event" value="targets 0..1 {xor other target}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=16;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eEventNotification" edge="1" parent="1" source="event" target="notification" value="may trigger 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=16;"><mxGeometry relative="1" as=