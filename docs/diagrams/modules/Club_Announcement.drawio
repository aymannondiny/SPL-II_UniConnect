        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" value="UniConnect – Corrected Club, Announcement and Event Class Diagram" vertex="1"><mxGeometry x="410" y="20" width="1480" height="50" as="geometry" /></mxCell>

        <mxCell id="user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- userId : Long&lt;br&gt;- platformRole : PlatformRole&lt;br&gt;- accountStatus : AccountStatus&lt;/div&gt;" vertex="1"><mxGeometry x="1070" y="100" width="390" height="230" as="geometry" /></mxCell>
        <mxCell id="assignment" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«shared»&lt;br&gt;ClubRoleAssignment&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- assignmentId : Long&lt;br&gt;- role : ClubRole&lt;br&gt;- assignedAt : LocalDateTime&lt;br&gt;- revokedAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ isCurrent() : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="80" y="430" width="440" height="340" as="geometry" /></mxCell>
        <mxCell id="club" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«shared»&lt;br&gt;Club&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- clubId : Long&lt;br&gt;- clubName : String&lt;br&gt;- category : String&lt;br&gt;- description : String&lt;br&gt;- logoUrl : String [0..1]&lt;br&gt;- contactEmail : String [0..1]&lt;br&gt;- status : ClubStatus&lt;br&gt;- createdAt : LocalDateTime&lt;br&gt;- updatedAt : LocalDateTime&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ canPublish() : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="640" y="430" width="480" height="468" as="geometry" /></mxCell>
        <mxCell id="announcement" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;Announcement&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- announcementId : Long&lt;br&gt;- title : String&lt;br&gt;- content : String&lt;br&gt;- priority : AnnouncementPriority&lt;br&gt;- status : AnnouncementStatus&lt;br&gt;- createdAt : LocalDateTime&lt;br&gt;- publishedAt : LocalDateTime [0..1]&lt;br&gt;- updatedAt : LocalDateTime [0..1]&lt;br&gt;- expiresAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ publish()&lt;br&gt;+ edit()&lt;br&gt;+ unpublish()&lt;br&gt;+ remove()&lt;br&gt;+ isVisible() : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="1230" y="390" width="470" height="538" as="geometry" /></mxCell>

        <mxCell id="clubRole" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;ClubRole&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;CLUB_ADMINISTRATOR&lt;br&gt;REPRESENTATIVE&lt;/div&gt;" vertex="1"><mxGeometry x="80" y="1050" width="360" height="190" as="geometry" /></mxCell>
        <mxCell id="clubStatus" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;ClubStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;ACTIVE&lt;br&gt;PUBLISHING_SUSPENDED&lt;br&gt;REMOVED&lt;/div&gt;" vertex="1"><mxGeometry x="490" y="1050" width="370" height="210" as="geometry" /></mxCell>
        <mxCell id="announcementStatus" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;AnnouncementStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;PUBLISHED&lt;br&gt;UNPUBLISHED&lt;br&gt;EXPIRED&lt;br&gt;REMOVED&lt;/div&gt;" vertex="1"><mxGeometry x="1280" y="1050" width="390" height="240" as="geometry" /></mxCell>

        <mxCell id="moderation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;ModerationAction&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- actionId : Long&lt;br&gt;- actionType : ActionType&lt;br&gt;- reason : String&lt;br&gt;- createdAt : LocalDateTime&lt;/div&gt;" vertex="1"><mxGeometry x="720" y="1500" width="430" height="270" as="geometry" /></mxCell>
        <mxCell id="notification" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;Notification&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- notificationId : Long&lt;br&gt;- recipient : User&lt;br&gt;- type : NotificationType&lt;/div&gt;" vertex="1"><mxGeometry x="1280" y="1510" width="390" height="220" as="geometry" /></mxCell>

        <mxCell id="rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=17;" value="&lt;b&gt;Module constraints&lt;/b&gt;&lt;br&gt;1. Creation of a Club and its first administrator assignment is atomic.&lt;br&gt;2. Each non-removed Club has exactly one current administrator assignment; each User administers at most one Club.&lt;br&gt;3. Current means revokedAt = null. No active flag and no automatic assignment expiry.&lt;br&gt;4. Assignees must be ACTIVE STUDENT users; no User holds both current roles for the same Club.&lt;br&gt;5. A representative manages only Announcements and Events authored through their own assignment; the Club administrator manages all such publications of that Club.&lt;br&gt;6. Publishing requires an ACTIVE user, a current assignment for the Club, and Club.status = ACTIVE.&lt;br&gt;7. PUBLISHING_SUSPENDED blocks new publication but does not hide the Club or already-published content.&lt;br&gt;8. Event is separate from Announcement. endsAt is its expiry boundary and must be later than startsAt.&lt;br&gt;9. EventTimingLabel is derived at read time: UPCOMING before startsAt, ACTIVE from startsAt through endsAt, and PAST afterward.&lt;br&gt;10. Current Event lists show PUBLISHED UPCOMING and ACTIVE Events. PUBLISHED PAST Events remain in Club Event history; REMOVED Events are not public.&lt;br&gt;11. Events are informational only: no RSVP, registration, attendance, ticketing, or participant management.&lt;br&gt;12. Public visibility is an access rule, not a recipient association to every User." vertex="1"><mxGeometry x="2490" y="210" width="500" height="1140" as="geometry" /></mxCell>

        <mxCell id="eClubAssignment" edge="1" parent="1" source="club" target="assignment" value="club 1     assignments 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
