        <mxCell id="eClubStatus" edge="1" parent="1" source="club" target="clubStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eAnnouncementStatus" edge="1" parent="1" source="announcement" target="announcementStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eModeratesClub" edge="1" parent="1" source="moderation" target="club" value="targets 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
