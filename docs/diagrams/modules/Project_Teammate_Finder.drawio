        <mxCell id="eProjectSkill" edge="1" parent="1" source="project" target="projectSkill" value="project 1     skill needs 1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eSkill" edge="1" parent="1" source="skill" target="projectSkill" value="skill 1     project uses 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2030" y="390" /><mxPoint x="2030" y="1440" /><mxPoint x="1500" y="1440" /></Array></mxGeometry></mxCell>
        <mxCell id="eService" edge="1" parent="1" source="service" target="project" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eRecommendationProject" edge="1" parent="1" source="service" target="recommendation" value="calculates 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="940" /><mxPoint x="2110" y="940" /></Array></mxGeometry></mxCell>
        <mxCell id="eRecommendationCandidate" edge="1" parent="1" source="student" target="recommendation" value="candidate 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eNotification" edge="1" parent="1" source="application" target="notification" value="triggers 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eProjectStatus" edge="1" parent="1" source="project" target="projectStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eApplicationStatus" edge="1" parent="1" source="application" target="applicationStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="850" /><mxPoint x="555" y="850" /></Array></mxGeometry></mxCell>
        <mxCell id="eMemberRole" edge="1" parent="1" source="membership" target="memberRole" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
