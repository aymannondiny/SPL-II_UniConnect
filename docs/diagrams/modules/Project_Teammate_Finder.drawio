<mxfile host="app.diagrams.net" agent="ChatGPT">
  <diagram id="project-teammate-finder-corrected" name="Project Teammate Finder Corrected">
    <mxGraphModel dx="2500" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" value="UniConnect – Corrected Project Teammate Finder Class Diagram" vertex="1"><mxGeometry x="430" y="20" width="1640" height="50" as="geometry" /></mxCell>

        <mxCell id="user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- userId : Long&lt;br&gt;- platformRole : PlatformRole&lt;br&gt;- accountStatus : AccountStatus&lt;/div&gt;" vertex="1"><mxGeometry x="850" y="100" width="370" height="225" as="geometry" /></mxCell>
        <mxCell id="student" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;«profile-module reference»&lt;br&gt;StudentProfile&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- studentNumber : String&lt;br&gt;- projectAvailability : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="1320" y="110" width="390" height="205" as="geometry" /></mxCell>
        <mxCell id="skill" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;«profile-module reference»&lt;br&gt;Skill&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- skillId : Long&lt;br&gt;- skillName : String {unique}&lt;br&gt;- category : String [0..1]&lt;/div&gt;" vertex="1"><mxGeometry x="1850" y="105" width="360" height="220" as="geometry" /></mxCell>

        <mxCell id="service" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«domain service»&lt;br&gt;ProjectTeammateService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ createProject(creatorId, details)&lt;br&gt;+ updateProject(projectId, creatorId, details)&lt;br&gt;+ closeProject(projectId, creatorId)&lt;br&gt;+ reopenProject(projectId, creatorId)&lt;br&gt;+ deleteProject(projectId, creatorId)&lt;br&gt;+ submitApplication(projectId, applicantId, message)&lt;br&gt;+ acceptApplication(applicationId, creatorId)&lt;br&gt;+ rejectApplication(applicationId, creatorId)&lt;br&gt;+ recommendCandidates(projectId)&lt;/div&gt;" vertex="1"><mxGeometry x="70" y="430" width="520" height="475" as="geometry" /></mxCell>

        <mxCell id="project" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;Project&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- projectId : Long&lt;br&gt;- title : String&lt;br&gt;- description : String&lt;br&gt;- teamSizeLimit : Integer&lt;br&gt;- duration : String [0..1]&lt;br&gt;- courseName : String [0..1]&lt;br&gt;- deadline : LocalDate [0..1]&lt;br&gt;- status : ProjectStatus&lt;br&gt;- createdAt : LocalDateTime&lt;br&gt;- updatedAt : LocalDateTime&lt;br&gt;- deletedAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ currentMemberCount() : int&lt;br&gt;+ openPositionCount() : int&lt;br&gt;+ hasOpenPosition() : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="730" y="420" width="470" height="600" as="geometry" /></mxCell>

        <mxCell id="application" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;ProjectApplication&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- applicationId : Long&lt;br&gt;- message : String [0..1] {max 500}&lt;br&gt;- status : ApplicationStatus&lt;br&gt;- appliedAt : LocalDateTime&lt;br&gt;- respondedAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ isPending() : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="1370" y="455" width="430" height="350" as="geometry" /></mxCell>

        <mxCell id="membership" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;ProjectMembership&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- membershipId : Long&lt;br&gt;- role : ProjectMemberRole&lt;br&gt;- joinedAt : LocalDateTime&lt;/div&gt;" vertex="1"><mxGeometry x="750" y="1190" width="410" height="250" as="geometry" /></mxCell>

        <mxCell id="projectSkill" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;ProjectSkill&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- projectSkillId : Long&lt;br&gt;- required : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="1320" y="1170" width="360" height="225" as="geometry" /></mxCell>

        <mxCell id="recommendation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«calculated result»&lt;br&gt;TeammateRecommendation&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- candidate : StudentProfile&lt;br&gt;- matchedSkills : List&amp;lt;Skill&amp;gt;&lt;br&gt;- score : Double&lt;br&gt;- explanation : String&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;&quot;&gt;Transient; weights are configuration, not domain constants.&lt;/div&gt;" vertex="1"><mxGeometry x="1880" y="520" width="430" height="330" as="geometry" /></mxCell>

        <mxCell id="notification" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;Notification&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- notificationId : Long&lt;br&gt;- recipient : User&lt;br&gt;- type : NotificationType&lt;br&gt;- eventKey : String&lt;/div&gt;" vertex="1"><mxGeometry x="1880" y="990" width="420" height="250" as="geometry" /></mxCell>

        <mxCell id="projectStatus" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;ProjectStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;OPEN&lt;br&gt;CLOSED&lt;br&gt;DELETED&lt;/div&gt;" vertex="1"><mxGeometry x="80" y="1040" width="290" height="210" as="geometry" /></mxCell>
        <mxCell id="applicationStatus" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;ApplicationStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;PENDING&lt;br&gt;ACCEPTED&lt;br&gt;REJECTED&lt;/div&gt;" vertex="1"><mxGeometry x="400" y="1040" width="310" height="210" as="geometry" /></mxCell>
        <mxCell id="memberRole" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;ProjectMemberRole&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;CREATOR&lt;br&gt;TEAMMATE&lt;/div&gt;" vertex="1"><mxGeometry x="390" y="1320" width="320" height="185" as="geometry" /></mxCell>

        <mxCell id="rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=16;" value="&lt;b&gt;Module constraints&lt;/b&gt;&lt;br&gt;P1. Only an ACTIVE STUDENT may create a project, apply, or be a member. Every protected action rechecks AccountStatus.&lt;br&gt;P2. teamSizeLimit is total capacity including the creator and must be at least 2. openPositionCount = teamSizeLimit − currentMemberCount; it is derived, not stored.&lt;br&gt;P3. Project creation atomically creates exactly one CREATOR membership for the creator. Each project has exactly one CREATOR membership and at least one membership overall.&lt;br&gt;P4. A StudentProfile may have at most one membership per project. The creator cannot apply to their own project; an existing member cannot apply.&lt;br&gt;P5. At most one application exists per project/applicant pair. Only OPEN projects accept new applications, and the application message is optional with a 500-character maximum.&lt;br&gt;P6. Only the project creator may view or process applications. Only PENDING may transition to ACCEPTED or REJECTED.&lt;br&gt;P7. Accepting a pending application atomically checks remaining capacity, changes it to ACCEPTED, and creates one TEAMMATE membership. It must fail without partial change if capacity is full.&lt;br&gt;P8. Closing blocks new applications. Applications submitted before closing remain reviewable; the creator may accept one only while capacity remains. Reopening requires at least one open position.&lt;br&gt;P9. Deletion is soft: status becomes DELETED and deletedAt is set. The project is hidden from normal use while projects, applications, memberships, and audit history are retained.&lt;br&gt;P10. COMPLETED, member leave, and member removal are outside current requirements.&lt;br&gt;P11. ProjectSkill records required/optional skills. TeammateRecommendation is calculated, not persisted; no fixed weighting formula is a confirmed business rule.&lt;br&gt;P12. Recommendation and direct skill-search candidates must be ACTIVE STUDENT users, projectAvailable, not the creator, not already members, and otherwise eligible. Notifications are informational only." vertex="1"><mxGeometry x="80" y="1540" width="2280" height="300" as="geometry" /></mxCell>

        <mxCell id="eUserStudent" edge="1" parent="1" source="user" target="student" value="user 1     student profile 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
