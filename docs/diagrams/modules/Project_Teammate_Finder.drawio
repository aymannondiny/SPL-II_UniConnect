        <mxCell id="eNotification" edge="1" parent="1" source="application" target="notification" value="triggers 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=17;"><mxGeometry relative="1" as="geometry" /></mxCell>
