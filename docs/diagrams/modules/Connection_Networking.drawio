<mxfile host="app.diagrams.net" agent="ChatGPT">
  <diagram id="connection-networking-corrected" name="Connection and Networking Corrected">
    <mxGraphModel dx="2200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" value="UniConnect – Corrected Connection and Networking Class Diagram" vertex="1"><mxGeometry x="360" y="20" width="1480" height="50" as="geometry" /></mxCell>

        <mxCell id="user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- userId : Long&lt;br&gt;- platformRole : PlatformRole&lt;br&gt;- accountStatus : AccountStatus&lt;/div&gt;" vertex="1"><mxGeometry x="820" y="100" width="410" height="230" as="geometry" /></mxCell>

        <mxCell id="connectionService" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=19;" value="&lt;div&gt;&lt;b&gt;«domain service»&lt;br&gt;ConnectionService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ sendRequest(requesterId, receiverId, introduction)&lt;br&gt;+ accept(connectionId, actingUserId)&lt;br&gt;+ reject(connectionId, actingUserId)&lt;br&gt;+ cancel(connectionId, actingUserId)&lt;br&gt;+ remove(connectionId, actingUserId)&lt;br&gt;+ listConnections(userId)&lt;br&gt;+ countConnections(userId) : long&lt;/div&gt;" vertex="1"><mxGeometry x="120" y="410" width="520" height="390" as="geometry" /></mxCell>

        <mxCell id="connection" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;Connection&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- connectionId : Long&lt;br&gt;- status : ConnectionStatus&lt;br&gt;- introductoryMessage : String [0..1]&lt;br&gt;- requestedAt : LocalDateTime&lt;br&gt;- acceptedAt : LocalDateTime [0..1]&lt;br&gt;- closedAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ isPending() : boolean&lt;br&gt;+ isAccepted() : boolean&lt;br&gt;+ connects(userA, userB) : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="790" y="430" width="470" height="410" as="geometry" /></mxCell>

        <mxCell id="conversation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«chat-module reference»&lt;br&gt;Conversation&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- conversationId : Long&lt;br&gt;- createdAt : LocalDateTime&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;&quot;&gt;Created only with the first ordinary message.&lt;/div&gt;" vertex="1"><mxGeometry x="1430" y="450" width="420" height="270" as="geometry" /></mxCell>

        <mxCell id="connectionStatus" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«enumeration»&lt;br&gt;ConnectionStatus&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;PENDING&lt;br&gt;ACCEPTED&lt;br&gt;REJECTED&lt;br&gt;CANCELLED&lt;br&gt;REMOVED&lt;/div&gt;" vertex="1"><mxGeometry x="800" y="1020" width="370" height="290" as="geometry" /></mxCell>

        <mxCell id="notification" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;Notification&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- notificationId : Long&lt;br&gt;- recipient : User&lt;br&gt;- type : NotificationType&lt;br&gt;- eventKey : String&lt;/div&gt;" vertex="1"><mxGeometry x="1390" y="930" width="420" height="270" as="geometry" /></mxCell>

        <mxCell id="rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=17;" value="&lt;b&gt;Module constraints&lt;/b&gt;&lt;br&gt;1. Requester and receiver are distinct ACTIVE users; every protected action rechecks AccountStatus.&lt;br&gt;2. Only the receiver may accept or reject a pending request. Only the requester may cancel it. Either participant may remove an accepted connection.&lt;br&gt;3. At most one open Connection exists for an unordered user pair, where open means PENDING or ACCEPTED. Reversing requester and receiver cannot bypass this constraint.&lt;br&gt;4. ACCEPTED represents one mutual first-degree connection; connection counts are derived and are not stored on User.&lt;br&gt;5. introductoryMessage is optional request content. It is not an ordinary chat Message and does not create a Conversation.&lt;br&gt;6. An ACCEPTED Connection enables 0..1 direct Conversation. The Conversation is created only when the first ordinary message is sent.&lt;br&gt;7. Removing the Connection blocks future ordinary messages but preserves existing Conversation and Message history.&lt;br&gt;8. REJECTED, CANCELLED, and REMOVED records are retained as history; a later new request may be permitted.&lt;br&gt;9. Notifications are informational and never create or restore authorization." vertex="1"><mxGeometry x="1870" y="170" width="310" height="1120" as="geometry" /></mxCell>

        <mxCell id="eRequester" edge="1" parent="1" source="user" target="connection" value="requester 1     requests 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="380" /><mxPoint x="900" y="380" /></Array></mxGeometry></mxCell>
        <mxCell id="eReceiver" edge="1" parent="1" source="user" target="connection" value="receiver 1     received requests 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="380" /><mxPoint x="1170" y="380" /></Array></mxGeometry></mxCell>
        <mxCell id="eServiceConnection" edge="1" parent="1" source="connectionService" target="connection" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eStatus" edge="1" parent="1" source="connection" target="connectionStatus" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eConversation" edge="1" parent="1" source="connection" target="conversation" value="accepted connection 1     conversation 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eNotification" edge="1" parent="1" source="connection" target="notification" value="triggers 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
