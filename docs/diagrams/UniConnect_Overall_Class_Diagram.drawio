        <mxCell id="eUserAssignment" edge="1" parent="1" source="user" target="assignment" value="assignee 1     assignments 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=16;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="820" /><mxPoint x="730" y="820" /></Array></mxGeometry></mxCell>
