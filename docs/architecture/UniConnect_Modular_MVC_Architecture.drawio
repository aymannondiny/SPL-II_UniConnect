<mxfile host="app.diagrams.net" agent="ChatGPT Codex" version="24.7.17">
  <diagram id="mvc-overview" name="1 - Modular MVC Architecture">
    <mxGraphModel dx="2600" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;UniConnect Modular MVC Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Flutter View • Spring REST Controller • Domain-Centred Model • Modular Monolith&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="2100" height="80" as="geometry" />
        </mxCell>

        <mxCell id="view" value="&lt;b&gt;VIEW — Flutter Client&lt;/b&gt;" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;fontSize=23;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="720" height="1410" as="geometry" />
        </mxCell>
        <mxCell id="view_responsibility" value="&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;Render application state&lt;br&gt;Collect and validate basic form input&lt;br&gt;Show loading, success and error states&lt;br&gt;Navigate between screens&lt;br&gt;Send HTTP / WebSocket requests&lt;br&gt;&lt;br&gt;&lt;i&gt;No database access or authoritative business rules&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=18;spacing=12;" vertex="1" parent="view">
          <mxGeometry x="45" y="80" width="630" height="270" as="geometry" />
        </mxCell>
        <mxCell id="view_features" value="&lt;b&gt;Feature Views&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authentication &amp;amp; Profiles&lt;br&gt;Discovery &amp;amp; Connections&lt;br&gt;Clubs, Announcements &amp;amp; Events&lt;br&gt;Projects &amp;amp; Applications&lt;br&gt;Career Board&lt;br&gt;Peer Mentorship&lt;br&gt;Direct Chat&lt;br&gt;Notifications&lt;br&gt;Administration &amp;amp; Reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=19;spacing=12;" vertex="1" parent="view">
          <mxGeometry x="45" y="395" width="630" height="430" as="geometry" />
        </mxCell>
        <mxCell id="view_components" value="&lt;b&gt;Flutter Components&lt;/b&gt;&lt;br&gt;&lt;br&gt;Screens and Widgets&lt;br&gt;Feature UI State&lt;br&gt;Navigation / Routing&lt;br&gt;API Client&lt;br&gt;WebSocket Client&lt;br&gt;Request / Response Models&lt;br&gt;Secure Token Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=19;spacing=12;" vertex="1" parent="view">
          <mxGeometry x="45" y="875" width="630" height="350" as="geometry" />
        </mxCell>
        <mxCell id="actors" value="&lt;b&gt;Actors&lt;/b&gt;&lt;br&gt;Student • Alumni • Club Administrator&lt;br&gt;Club Representative • System Administrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#6C8EBF;fontSize=17;spacing=10;" vertex="1" parent="view">
          <mxGeometry x="45" y="1270" width="630" height="100" as="geometry" />
        </mxCell>

        <mxCell id="controller" value="&lt;b&gt;CONTROLLER — Spring Web Adapters&lt;/b&gt;" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=3;fontSize=23;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="140" width="720" height="1410" as="geometry" />
        </mxCell>
        <mxCell id="controller_responsibility" value="&lt;b&gt;Responsibilities&lt;/b&gt;&lt;br&gt;Receive REST / WebSocket requests&lt;br&gt;Authenticate the requester&lt;br&gt;Validate request shape&lt;br&gt;Delegate to one application service&lt;br&gt;Map results to response DTOs&lt;br&gt;Return HTTP status and errors&lt;br&gt;&lt;br&gt;&lt;i&gt;Controllers remain thin; no persistence logic&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=18;spacing=12;" vertex="1" parent="controller">
          <mxGeometry x="45" y="80" width="630" height="290" as="geometry" />
        </mxCell>
        <mxCell id="controller_features" value="&lt;b&gt;Feature Controllers&lt;/b&gt;&lt;br&gt;&lt;br&gt;AuthController • ProfileController&lt;br&gt;DiscoveryController • ConnectionController&lt;br&gt;ClubController • AnnouncementController&lt;br&gt;EventController • ProjectController&lt;br&gt;CareerController • MentorshipController&lt;br&gt;ChatController • NotificationController&lt;br&gt;AdministrationController • ReportController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=18;spacing=12;" vertex="1" parent="controller">
          <mxGeometry x="45" y="415" width="630" height="390" as="geometry" />
        </mxCell>
        <mxCell id="controller_boundary" value="&lt;b&gt;Boundary Components&lt;/b&gt;&lt;br&gt;&lt;br&gt;Request DTOs and Bean Validation&lt;br&gt;Response DTOs and Mappers&lt;br&gt;Global Exception Handler&lt;br&gt;JWT Authentication Filter&lt;br&gt;WebSocket Handshake / Message Mapping&lt;br&gt;API Versioning and OpenAPI Contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=18;spacing=12;" vertex="1" parent="controller">
          <mxGeometry x="45" y="850" width="630" height="330" as="geometry" />
        </mxCell>
        <mxCell id="controller_rule" value="&lt;b&gt;Controller Rule&lt;/b&gt;&lt;br&gt;Controller → Service&lt;br&gt;Never Controller → Repository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=19;spacing=10;" vertex="1" parent="controller">
          <mxGeometry x="120" y="1230" width="480" height="120" as="geometry" />
        </mxCell>

        <mxCell id="model" value="&lt;b&gt;MODEL — Business State, Rules and Persistence&lt;/b&gt;" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=3;fontSize=23;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1630" y="140" width="1000" height="1410" as="geometry" />
        </mxCell>
        <mxCell id="services" value="&lt;b&gt;Application / Domain Services&lt;/b&gt;&lt;br&gt;&lt;br&gt;Identity &amp;amp; Access • Profile &amp;amp; Discovery&lt;br&gt;Club Governance • Announcement • Event&lt;br&gt;Connection • Project • Career • Mentorship&lt;br&gt;Chat • Notification • Administration • Reporting&lt;br&gt;&lt;br&gt;&lt;i&gt;Use-case coordination, authorization, validation and transactions&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=18;spacing=12;" vertex="1" parent="model">
          <mxGeometry x="45" y="80" width="910" height="280" as="geometry" />
        </mxCell>
        <mxCell id="domain" value="&lt;b&gt;Canonical Domain Model&lt;/b&gt;&lt;br&gt;&lt;br&gt;User • StudentProfile • AlumniProfile&lt;br&gt;PlatformRole • AccountStatus&lt;br&gt;Club • ClubRoleAssignment&lt;br&gt;ConnectionRequest • Connection&lt;br&gt;Announcement • Event • Project • Application&lt;br&gt;Mentorship • Conversation • Message&lt;br&gt;CareerPost • Notification • ContentReport • AuditLog&lt;br&gt;&lt;br&gt;&lt;i&gt;Entities, value objects, enums, invariants and lifecycle rules&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=18;spacing=12;" vertex="1" parent="model">
          <mxGeometry x="45" y="405" width="910" height="400" as="geometry" />
        </mxCell>
        <mxCell id="repositories" value="&lt;b&gt;Persistence Ports / Repositories&lt;/b&gt;&lt;br&gt;&lt;br&gt;UserRepository • ClubRepository • ConnectionRepository&lt;br&gt;AnnouncementRepository • EventRepository • ProjectRepository&lt;br&gt;MentorshipRepository • ConversationRepository&lt;br&gt;CareerPostRepository • NotificationRepository • ReportRepository&lt;br&gt;&lt;br&gt;Spring Data JPA • Hibernate • Transaction Boundaries • Flyway Migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=18;spacing=12;" vertex="1" parent="model">
          <mxGeometry x="45" y="850" width="910" height="280" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="&lt;b&gt;Persistence and External Infrastructure&lt;/b&gt;&lt;br&gt;PostgreSQL • File/Object Storage • Email Provider" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=18;spacingTop=12;" vertex="1" parent="model">
          <mxGeometry x="180" y="1180" width="640" height="150" as="geometry" />
        </mxCell>

        <mxCell id="crosscut" value="&lt;b&gt;Shared engineering policies:&lt;/b&gt; SOLID • Clean Code • authentication • authorization • validation • transactions • exception handling • auditing • logging • time • file security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=18;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="1610" width="2140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Deployment style:&lt;/b&gt; one Flutter client + one Spring Boot modular monolith + one PostgreSQL database. Modules communicate through services, not through one another’s repositories." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=18;align=center;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="1740" width="2020" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="HTTP / JSON&#xa;WebSocket" edge="1" parent="1" source="view" target="controller" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=4;fontSize=17;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="delegates use cases" edge="1" parent="1" source="controller" target="model" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=4;fontSize=17;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="calls" edge="1" parent="model" source="services" target="domain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="loads / saves" edge="1" parent="model" source="services" target="repositories" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="persists" edge="1" parent="model" source="repositories" target="storage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="package-structure" name="2 - Project and Package Structure">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="p0" />
        <mxCell id="p1" parent="p0" />
        <mxCell id="ptitle" value="&lt;b&gt;UniConnect Exact Project Structure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Feature-first modular MVC organization&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontColor=#1F2937;" vertex="1" parent="p1">
          <mxGeometry x="300" y="20" width="2000" height="80" as="geometry" />
        </mxCell>

        <mxCell id="repo" value="&lt;b&gt;SPL-II_UniConnect/&lt;/b&gt;&lt;br&gt;README.md • AGENTS.md • .gitignore • docker-compose.yml • docs/ • backend/ • frontend/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=3;fontSize=20;spacing=12;" vertex="1" parent="p1">
          <mxGeometry x="170" y="130" width="2260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="backend" value="&lt;b&gt;backend/ — Spring Boot&lt;/b&gt;" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=3;fontSize=23;fontStyle=1;" vertex="1" parent="p1">
          <mxGeometry x="80" y="290" width="1500" height="1350" as="geometry" />
        </mxCell>
        <mxCell id="backend_root" value="&lt;b&gt;src/main/java/com/uniconnect/&lt;/b&gt;&lt;br&gt;UniConnectApplication.java" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=18;align=left;spacing=12;" vertex="1" parent="backend">
          <mxGeometry x="40" y="75" width="1420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="shared" value="&lt;b&gt;shared/&lt;/b&gt;&lt;br&gt;config/ — Spring, CORS, OpenAPI, WebSocket&lt;br&gt;security/ — JWT, authentication, authorization&lt;br&gt;exception/ — typed errors and global handler&lt;br&gt;audit/ — audit recording infrastructure&lt;br&gt;storage/ — attachment/file abstraction&lt;br&gt;util/ — small genuinely shared utilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=18;align=left;spacing=12;" vertex="1" parent="backend">
          <mxGeometry x="40" y="205" width="680" height="330" as="geometry" />
        </mxCell>
        <mxCell id="feature_template" value="&lt;b&gt;Every feature package uses this template&lt;/b&gt;&lt;br&gt;&lt;br&gt;feature/&lt;br&gt;├── controller/ — REST/WebSocket adapters&lt;br&gt;├── dto/request/ — validated input contracts&lt;br&gt;├── dto/response/ — output contracts&lt;br&gt;├── mapper/ — entity/DTO conversion&lt;br&gt;├── service/ — use cases and business rules&lt;br&gt;├── model/ — entities, enums, value objects&lt;br&gt;└── repository/ — Spring Data interfaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=18;align=left;spacing=12;" vertex="1" parent="backend">
          <mxGeometry x="750" y="205" width="710" height="420" as="geometry" />
        </mxCell>
        <mxCell id="features_a" value="&lt;b&gt;Foundation feature packages&lt;/b&gt;&lt;br&gt;&lt;br&gt;authentication/&lt;br&gt;profile/&lt;br&gt;administration/&lt;br&gt;notification/&lt;br&gt;reporting/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=19;align=left;spacing=12;" vertex="1" parent="backend">
          <mxGeometry x="40" y="575" width="680" height="300" as="geometry" />
        </mxCell>
        <mxCell id="features_b" value="&lt;b&gt;Core feature packages&lt;/b&gt;&lt;br&gt;&lt;br&gt;discovery/&lt;br&gt;connection/&lt;br&gt;club/&lt;br&gt;project/&lt;br&gt;career/&lt;br&gt;mentorship/&lt;br&gt;chat/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=19;align=left;spacing=12;" vertex="1" parent="backend">
          <mxGeometry x="750" y="665" width="710" height="330" as="geometry" />
        </mxCell>
        <mxCell id="resources" value="&lt;b&gt;src/main/resources/&lt;/b&gt;&lt;br&gt;application.yml&lt;br&gt;application-dev.yml&lt;br&gt;application-test.yml&lt;br&gt;db/migration/V001__initial_schema.sql ...&lt;br&gt;&lt;br&gt;&lt;b&gt;src/test/java/com/uniconnect/&lt;/b&gt;&lt;br&gt;unit/ • integration/ • acceptance/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=18;align=left;spacing=12;" vertex="1" parent="backend">
          <mxGeometry x="40" y="1030" width="1420" height="250" as="geometry" />
        </mxCell>

        <mxCell id="frontend" value="&lt;b&gt;frontend/ — Flutter View&lt;/b&gt;" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;fontSize=23;fontStyle=1;" vertex="1" parent="p1">
          <mxGeometry x="1640" y="290" width="880" height="1350" as="geometry" />
        </mxCell>
        <mxCell id="flutter_root" value="&lt;b&gt;lib/&lt;/b&gt;&lt;br&gt;main.dart&lt;br&gt;app.dart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=18;align=left;spacing=12;" vertex="1" parent="frontend">
          <mxGeometry x="40" y="75" width="800" height="100" as="geometry" />
        </mxCell>
        <mxCell id="flutter_core" value="&lt;b&gt;core/&lt;/b&gt;&lt;br&gt;config/ — environment and endpoints&lt;br&gt;network/ — HTTP and WebSocket clients&lt;br&gt;auth/ — token/session handling&lt;br&gt;routing/ — navigation&lt;br&gt;theme/ — colours and typography&lt;br&gt;widgets/ — truly shared widgets&lt;br&gt;errors/ — UI error mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=18;align=left;spacing=12;" vertex="1" parent="frontend">
          <mxGeometry x="40" y="215" width="800" height="330" as="geometry" />
        </mxCell>
        <mxCell id="flutter_template" value="&lt;b&gt;Every Flutter feature&lt;/b&gt;&lt;br&gt;&lt;br&gt;features/feature_name/&lt;br&gt;├── view/ — screens and widgets&lt;br&gt;├── controller/ — presentation state/actions&lt;br&gt;├── model/ — UI/API data models&lt;br&gt;└── data/ — API gateway for the feature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=18;align=left;spacing=12;" vertex="1" parent="frontend">
          <mxGeometry x="40" y="585" width="800" height="300" as="geometry" />
        </mxCell>
        <mxCell id="flutter_features" value="&lt;b&gt;features/&lt;/b&gt;&lt;br&gt;authentication/ • profile/ • discovery/ • connection/&lt;br&gt;club/ • project/ • career/ • mentorship/ • chat/&lt;br&gt;notification/ • administration/ • reporting/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=18;align=left;spacing=12;" vertex="1" parent="frontend">
          <mxGeometry x="40" y="925" width="800" height="200" as="geometry" />
        </mxCell>
        <mxCell id="flutter_tests" value="&lt;b&gt;test/&lt;/b&gt;&lt;br&gt;unit/ • widget/ • integration/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=18;align=left;spacing=12;" vertex="1" parent="frontend">
          <mxGeometry x="40" y="1165" width="800" height="100" as="geometry" />
        </mxCell>

        <mxCell id="rule" value="&lt;b&gt;Dependency rule:&lt;/b&gt; View → Controller → Service → Repository. A feature may use another feature only through its public service/API contract; it must not reach into another feature’s repository." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=19;align=center;spacing=12;" vertex="1" parent="p1">
          <mxGeometry x="300" y="1680" width="2000" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="solid-clean-code" name="3 - SOLID and Clean Code Rules">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="s0" />
        <mxCell id="s1" parent="s0" />
        <mxCell id="stitle" value="&lt;b&gt;UniConnect SOLID and Clean Code Standard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Practical rules for a four-person, one-month implementation&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontColor=#1F2937;" vertex="1" parent="s1">
          <mxGeometry x="300" y="20" width="2000" height="80" as="geometry" />
        </mxCell>

        <mxCell id="solid" value="&lt;b&gt;SOLID PRINCIPLES&lt;/b&gt;" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=3;fontSize=23;fontStyle=1;" vertex="1" parent="s1">
          <mxGeometry x="80" y="140" width="1180" height="1170" as="geometry" />
        </mxCell>
        <mxCell id="srp" value="&lt;b&gt;S — Single Responsibility&lt;/b&gt;&lt;br&gt;One class has one clear reason to change.&lt;br&gt;Controller handles transport; service handles a use case; repository handles persistence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=18;align=left;spacing=12;" vertex="1" parent="solid">
          <mxGeometry x="40" y="80" width="1100" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ocp" value="&lt;b&gt;O — Open/Closed&lt;/b&gt;&lt;br&gt;Extend behaviour through focused strategies or policies when variation is real. Avoid editing one giant service for every new notification, report target or storage provider." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=18;align=left;spacing=12;" vertex="1" parent="solid">
          <mxGeometry x="40" y="260" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lsp" value="&lt;b&gt;L — Liskov Substitution&lt;/b&gt;&lt;br&gt;An implementation must honour the contract of the interface it replaces. Test doubles and alternate storage/notification implementations must preserve expected behaviour." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=18;align=left;spacing=12;" vertex="1" parent="solid">
          <mxGeometry x="40" y="450" width="1100" height="150" as="geometry" />
        </mxCell>
        <mxCell id="isp" value="&lt;b&gt;I — Interface Segregation&lt;/b&gt;&lt;br&gt;Prefer small capability-focused interfaces. A mail sender should not be forced to implement file storage, chat delivery or unrelated administrative operations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=18;align=left;spacing=12;" vertex="1" parent="solid">
          <mxGeometry x="40" y="630" width="1100" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dip" value="&lt;b&gt;D — Dependency Inversion&lt;/b&gt;&lt;br&gt;High-level business services depend on abstractions at external boundaries. Use constructor injection; do not instantiate repositories, encoders, clocks or external clients inside services." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=18;align=left;spacing=12;" vertex="1" parent="solid">
          <mxGeometry x="40" y="810" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="solidnote" value="&lt;b&gt;Pragmatic rule:&lt;/b&gt; introduce an interface when there is a genuine boundary, variation or testing need—not for every class." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=18;align=center;spacing=10;" vertex="1" parent="solid">
          <mxGeometry x="120" y="1010" width="940" height="90" as="geometry" />
        </mxCell>

        <mxCell id="clean" value="&lt;b&gt;CLEAN CODE RULES&lt;/b&gt;" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;fontSize=23;fontStyle=1;" vertex="1" parent="s1">
          <mxGeometry x="1340" y="140" width="1180" height="1170" as="geometry" />
        </mxCell>
        <mxCell id="names" value="&lt;b&gt;Reveal intent&lt;/b&gt;&lt;br&gt;Use domain names such as acceptConnectionRequest(), suspendAccount() and publishAnnouncement(). Avoid vague names such as process(), handleData() and util()." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=18;align=left;spacing=12;" vertex="1" parent="clean">
          <mxGeometry x="40" y="80" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="methods" value="&lt;b&gt;Keep units focused&lt;/b&gt;&lt;br&gt;Prefer short methods with one level of abstraction. Extract concepts when a method mixes authorization, business decisions, persistence and response formatting." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=18;align=left;spacing=12;" vertex="1" parent="clean">
          <mxGeometry x="40" y="270" width="1100" height="150" as="geometry" />
        </mxCell>
        <mxCell id="contracts" value="&lt;b&gt;Protect boundaries&lt;/b&gt;&lt;br&gt;Validate request DTOs, keep entities out of controller responses, use typed exceptions, never log passwords/tokens, and enforce authorization in the service." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=18;align=left;spacing=12;" vertex="1" parent="clean">
          <mxGeometry x="40" y="450" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="duplication" value="&lt;b&gt;Control duplication and complexity&lt;/b&gt;&lt;br&gt;Remove repeated business rules, but do not create premature generic frameworks. Prefer readable duplication briefly over the wrong abstraction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=18;align=left;spacing=12;" vertex="1" parent="clean">
          <mxGeometry x="40" y="640" width="1100" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tests" value="&lt;b&gt;Leave evidence&lt;/b&gt;&lt;br&gt;Test important business rules, write comments for why rather than what, keep commits focused, and require another teammate to review shared-model or security changes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=18;align=left;spacing=12;" vertex="1" parent="clean">
          <mxGeometry x="40" y="820" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cleannote" value="&lt;b&gt;Boy Scout rule:&lt;/b&gt; leave touched code slightly clearer, while keeping the pull request limited to its stated issue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#6C8EBF;fontSize=18;align=center;spacing=10;" vertex="1" parent="clean">
          <mxGeometry x="120" y="1020" width="940" height="80" as="geometry" />
        </mxCell>

        <mxCell id="review" value="&lt;b&gt;Pull-request quality gate&lt;/b&gt;&lt;br&gt;Correct requirement • clear responsibility • dependency direction respected • authorization enforced • names reveal intent • errors handled • tests added • secrets absent • unnecessary abstractions avoided" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=19;align=center;spacing=12;" vertex="1" parent="s1">
          <mxGeometry x="230" y="1370" width="2140" height="120" as="geometry" />
        </mxCell>
        <mxCell id="quality" value="SOLID and Clean Code are applied during design, implementation and review; they are not separate modules or end-of-project cleanup activities." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=19;align=center;spacing=12;" vertex="1" parent="s1">
          <mxGeometry x="330" y="1540" width="1940" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
