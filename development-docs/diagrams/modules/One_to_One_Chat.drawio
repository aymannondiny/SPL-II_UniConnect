<mxfile host="app.diagrams.net" agent="ChatGPT">
  <diagram id="one-to-one-chat-corrected" name="One-to-One Chat Corrected">
    <mxGraphModel dx="2500" dy="1850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" value="UniConnect – Corrected One-to-One Chat Class Diagram" vertex="1"><mxGeometry x="470" y="20" width="1500" height="50" as="geometry" /></mxCell>

        <mxCell id="user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- userId : Long&lt;br&gt;- platformRole : PlatformRole&lt;br&gt;- accountStatus : AccountStatus&lt;/div&gt;" vertex="1"><mxGeometry x="860" y="100" width="400" height="230" as="geometry" /></mxCell>

        <mxCell id="connection" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«networking-module reference»&lt;br&gt;Connection&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- connectionId : Long&lt;br&gt;- status : ConnectionStatus&lt;br&gt;- acceptedAt : LocalDateTime [0..1]&lt;br&gt;- closedAt : LocalDateTime [0..1]&lt;/div&gt;" vertex="1"><mxGeometry x="100" y="420" width="430" height="300" as="geometry" /></mxCell>

        <mxCell id="chatService" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«domain service»&lt;br&gt;ChatService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.42;&quot;&gt;+ sendMessage(senderId, receiverId, content)&lt;br&gt;+ listConversations(userId)&lt;br&gt;+ getHistory(conversationId, userId)&lt;br&gt;+ markDelivered(messageId, userId)&lt;br&gt;+ markRead(messageId, userId)&lt;br&gt;+ deleteForSelf(messageId, userId)&lt;br&gt;+ deleteForEveryone(messageId, userId)&lt;/div&gt;" vertex="1"><mxGeometry x="620" y="400" width="500" height="390" as="geometry" /></mxCell>

        <mxCell id="conversation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;Conversation&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- conversationId : Long&lt;br&gt;- createdAt : LocalDateTime&lt;br&gt;- lastMessageAt : LocalDateTime&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ getOtherParticipant(userId) : User&lt;br&gt;+ getUnreadCount(userId) : long&lt;/div&gt;" vertex="1"><mxGeometry x="1280" y="410" width="470" height="340" as="geometry" /></mxCell>

        <mxCell id="participant" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;ConversationParticipant&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- participantId : Long&lt;br&gt;- joinedAt : LocalDateTime&lt;/div&gt;" vertex="1"><mxGeometry x="1320" y="900" width="430" height="210" as="geometry" /></mxCell>

        <mxCell id="message" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;Message&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- messageId : Long&lt;br&gt;- content : String&lt;br&gt;- sentAt : LocalDateTime&lt;br&gt;- deletedForEveryoneAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ isDeletedForEveryone() : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="650" y="1000" width="480" height="330" as="geometry" /></mxCell>

        <mxCell id="participantState" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;MessageParticipantState&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- stateId : Long&lt;br&gt;- deliveredAt : LocalDateTime [0..1]&lt;br&gt;- readAt : LocalDateTime [0..1]&lt;br&gt;- deletedForSelfAt : LocalDateTime [0..1]&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;+ isVisibleToParticipant() : boolean&lt;/div&gt;" vertex="1"><mxGeometry x="1250" y="1280" width="500" height="360" as="geometry" /></mxCell>

        <mxCell id="notification" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#4d4d4d;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=20;" value="&lt;div&gt;&lt;b&gt;«shared reference»&lt;br&gt;Notification&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- notificationId : Long&lt;br&gt;- recipient : User&lt;br&gt;- type : NotificationType&lt;br&gt;- eventKey : String&lt;/div&gt;" vertex="1"><mxGeometry x="100" y="1640" width="420" height="270" as="geometry" /></mxCell>

        <mxCell id="rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=17;" value="&lt;b&gt;Module constraints&lt;/b&gt;&lt;br&gt;1. Ordinary messages require both users to be ACTIVE and their Connection to be ACCEPTED at the time of sending.&lt;br&gt;2. Accepting a Connection does not create a Conversation. The first valid send atomically creates the Conversation, its two participants, the first Message, and both participant-state records.&lt;br&gt;3. Each accepted unordered user pair has at most one Conversation. Participant A–B and B–A are the same pair. Group conversations are outside scope.&lt;br&gt;4. Every Conversation has exactly two distinct participants and at least one Message. A Message sender must be one of those participants.&lt;br&gt;5. Removing the Connection blocks new messages, but the Conversation and stored history remain viewable.&lt;br&gt;6. Empty content is rejected; content is limited to 5,000 characters.&lt;br&gt;7. Each Message has one MessageParticipantState per conversation participant. Delivery/read timestamps apply to the recipient state; unread counts are derived.&lt;br&gt;8. Either participant may delete a Message only from their own view by setting their own deletedForSelfAt.&lt;br&gt;9. Only the sender may set deletedForEveryoneAt. There is no deletion time limit in the current version.&lt;br&gt;10. Delete-for-everyone hides content from both views but preserves the historical record.&lt;br&gt;11. AccountStatus and Connection status are revalidated for every protected action; Notifications never grant access.&lt;br&gt;12. Either Conversation participant may report a Message that is accessible in their own history while ACTIVE. The report references only that Message; moderation review exposes no unrelated conversation history.&lt;br&gt;13. Reporting does not delete the Message, alter participant visibility, or grant the reporter moderation authority. Any later administrative action follows the separate reporting and moderation lifecycle." vertex="1"><mxGeometry x="1880" y="160" width="590" height="1760" as="geometry" /></mxCell>

        <mxCell id="eUserParticipant" edge="1" parent="1" source="user" target="participant" value="user 1     participations 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="850" /><mxPoint x="1460" y="850" /></Array></mxGeometry></mxCell>
        <mxCell id="eConnectionConversation" edge="1" parent="1" source="connection" target="conversation" value="accepted connection 1     conversation 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="830" /><mxPoint x="1510" y="830" /></Array></mxGeometry></mxCell>
        <mxCell id="eServiceConnection" edge="1" parent="1" source="chatService" target="connection" value="validates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eServiceConversation" edge="1" parent="1" source="chatService" target="conversation" value="creates or uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eConversationParticipant" edge="1" parent="1" source="conversation" target="participant" value="conversation 1     participants exactly 2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eConversationMessage" edge="1" parent="1" source="conversation" target="message" value="conversation 1     messages 1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="800" /><mxPoint x="900" y="800" /></Array></mxGeometry></mxCell>
        <mxCell id="eSender" edge="1" parent="1" source="participant" target="message" value="sender 1     messages sent 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eMessageState" edge="1" parent="1" source="message" target="participantState" value="message 1     participant states exactly 2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eParticipantStateOwner" edge="1" parent="1" source="participant" target="participantState" value="participant 1     message states 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=18;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eMessageNotification" edge="1" parent="1" source="message" target="notification" value="triggers 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=18;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="1450" /></Array></mxGeometry></mxCell>
      <mxCell id="contentReport" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;fontSize=18;" value="&lt;div&gt;&lt;b&gt;«reporting-module reference»&lt;br&gt;ContentReport&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.45;&quot;&gt;- reportId : Long&lt;br&gt;- reason : String&lt;br&gt;- status : ReportStatus&lt;br&gt;- submittedAt : LocalDateTime&lt;/div&gt;" vertex="1"><mxGeometry x="100" y="1280" width="420" height="280" as="geometry" /></mxCell><mxCell id="eUserContentReport" edge="1" parent="1" source="user" target="contentReport" value="reporter 1     reports 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=16;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eReportedMessage" edge="1" parent="1" source="contentReport" target="message" value="reported Message target 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=16;"><mxGeometry relative="1" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>